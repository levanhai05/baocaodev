FROM node:20-alpine
WORKDIR /app

# NEXT_PUBLIC_* được "đóng cứng" vào bundle lúc build -> phải truyền bằng ARG
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ARG NEXT_PUBLIC_BANK_ID
ARG NEXT_PUBLIC_BANK_ACCOUNT
ARG NEXT_PUBLIC_BANK_NAME
ARG NEXT_PUBLIC_TAWK_SRC
ENV NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL \
    NEXT_PUBLIC_SUPABASE_ANON_KEY=$NEXT_PUBLIC_SUPABASE_ANON_KEY \
    NEXT_PUBLIC_BANK_ID=$NEXT_PUBLIC_BANK_ID \
    NEXT_PUBLIC_BANK_ACCOUNT=$NEXT_PUBLIC_BANK_ACCOUNT \
    NEXT_PUBLIC_BANK_NAME=$NEXT_PUBLIC_BANK_NAME \
    NEXT_PUBLIC_TAWK_SRC=$NEXT_PUBLIC_TAWK_SRC \
    NEXT_TELEMETRY_DISABLED=1

COPY package*.json ./
RUN npm ci
COPY . .
# Key bí mật (SERVICE_ROLE, VNP_*, RESEND...) KHÔNG cần lúc build, chỉ cần lúc chạy
RUN SUPABASE_SERVICE_ROLE_KEY=build npm run build

ENV NODE_ENV=production
EXPOSE 3000
CMD ["npm", "start"]